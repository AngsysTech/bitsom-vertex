# LLM: one provider, used by app/core/llm.py only
LLM_PROVIDER=openai            # openai | anthropic (openai also covers OpenAI-compatible APIs via LLM_BASE_URL)
LLM_MODEL=gpt-6-luna
LLM_API_KEY=
LLM_REASONING_EFFORT=low       # OpenAI reasoning models; ~1.3 s/call vs ~5 s at default effort
# LLM_BASE_URL=

# STT: used by app/core/stt.py only (wraps the vendored audio_notes transcription service)
STT_PROVIDER=assemblyai        # assemblyai | whisper
ASSEMBLYAI_API_KEY=
# STT_OPENAI_API_KEY=          # whisper; falls back to OPENAI_API_KEY

# NOTES_CONCURRENCY=6          # parallel section calls in the vendored notes step
