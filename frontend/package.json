{
  "name": "student-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync-types": "node -e \"require('fs').copyFileSync('../contracts.ts','src/types.ts')\"",
    "dev": "node scripts/ensure-deps.mjs && vite",
    "build": "node scripts/ensure-deps.mjs && tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "postinstall": "node scripts/ensure-deps.mjs --stamp"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "oxlint": "1.16.0",
    "typescript": "~6.0.2",
    "vite": "^6.4.3"
  }
}
